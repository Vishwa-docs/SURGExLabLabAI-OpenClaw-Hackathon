# Ridhwan - Environment Configuration
# Copy to .env and fill in your values

# ===== Agent Config =====
AGENT_NAME=ridhwan-agent-01
AGENT_ID=

# ===== SURGE API (OpenClaw skill) =====
# Get your API key from https://surge.xyz
SURGE_API_URL=https://back.surge.xyz
SURGE_API_KEY=sk-surge-your-key-here
SURGE_WALLET_ID=
SURGE_CHAIN_ID=1

# ===== x402 Gasless =====
X402_ENDPOINT=https://x402.org/api
X402_API_KEY=

# ===== Moltbook =====
# Social network for AI agents — https://www.moltbook.com
MOLTBOOK_API_URL=https://www.moltbook.com/api/v1
MOLTBOOK_API_KEY=
MOLTBOOK_SUBMOLT=lablab

# ===== Social / Notifications =====
TWITTER_API_KEY=
TWITTER_API_SECRET=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ===== LLM =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== Server =====
PORT=3000
DASHBOARD_PORT=3001
NODE_ENV=development

# ===== Database =====
DB_PATH=./data/ridhwan.db
