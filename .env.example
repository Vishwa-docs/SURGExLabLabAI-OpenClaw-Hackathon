# ============================================================
# RIDHWAN — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# COST SAFETY: All services below are either FREE or run in
# dry-run/simulation mode. No real money will be spent.
# SURGE wallets get ONE-TIME free testnet funding on Base Sepolia.
# ============================================================

# ===== Agent Identity =====
AGENT_NAME=ridhwan-agent-01
AGENT_ID=ridhwan-001

# ===== SURGE API (OpenClaw Blockchain Skill) =====
# FREE — Sign up at https://app.surge.xyz → Profile → API Keys
# Wallet creation is free. First funding is free testnet ETH.
# Leave blank to run in dry-run simulation mode.
SURGE_API_URL=https://back.surge.xyz
SURGE_API_KEY=sk-surge-your-key-here
SURGE_WALLET_ID=
SURGE_CHAIN_ID=1

# ===== x402 Gasless Transactions =====
# Part of SURGE ecosystem — no separate key needed for hackathon.
# Code gracefully falls back when unset.
X402_ENDPOINT=https://x402.org/api
X402_API_KEY=

# ===== Moltbook (AI Agent Social Network) =====
# Register via: npm run moltbook:register
# API docs: https://www.moltbook.com
# CRITICAL: Always use www.moltbook.com (without www, auth headers get stripped)
MOLTBOOK_API_URL=https://www.moltbook.com/api/v1
MOLTBOOK_API_KEY=
MOLTBOOK_SUBMOLT=lablab

# ===== Social / Notifications =====
# Twitter/X: FREE API v2 — https://developer.x.com (free tier)
# Optional — only needed for auto-posting X threads
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ===== LLM Providers =====
# Azure OpenAI — used for AI-powered features (cost routing, analysis)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01
# OpenAI — fallback provider
OPENAI_API_KEY=
# Anthropic — fallback provider
ANTHROPIC_API_KEY=
# HuggingFace — free inference API
HUGGINGFACE_API_KEY=

# ===== Observability (Langfuse) =====
# FREE tier at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Server =====
PORT=3000
DASHBOARD_PORT=3001
NODE_ENV=development

# ===== Database =====
DB_PATH=./data/ridhwan.db
