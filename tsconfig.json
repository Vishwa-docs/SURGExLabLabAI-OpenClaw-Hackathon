{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@agent/*": ["src/agent/*"],
      "@policy/*": ["src/policy-engine/*"],
      "@surge/*": ["src/surge/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["src/**/*", "demo/**/*"],
  "exclude": ["node_modules", "dist", "src/dashboard"]
}
